# Required: CDN Configuration

# CDN base URL where templates are hosted
NEXT_PUBLIC_TEMPLATE_CDN=https://cdn.jsdelivr.net/gh/YOUR_USERNAME/buildbot-templates@main

# Example configurations:

# GitHub + jsDelivr (Free)
# NEXT_PUBLIC_TEMPLATE_CDN=https://cdn.jsdelivr.net/gh/yourusername/buildbot-templates@main

# Vercel Blob
# NEXT_PUBLIC_TEMPLATE_CDN=https://your-blob-url.vercel-storage.com

# Cloudflare R2
# NEXT_PUBLIC_TEMPLATE_CDN=https://pub-xxxxx.r2.dev

# AWS CloudFront
# NEXT_PUBLIC_TEMPLATE_CDN=https://d1234567890.cloudfront.net/templates
